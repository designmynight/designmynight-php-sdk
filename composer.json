{
    "name": "designmynight/designmynight-php-sdk",
    "type": "library",
    "description": "DesignMyNight API v4 client",
    "homepage": "https://github.com/DesignMyNight/designmynight-php-sdk",
    "keywords": ["designmynight"],
    "license": "MIT",
    "authors": [
        {
            "name": "DesignMyNight",
            "homepage": "https://www.designmynight.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": { "DesignMyNight\\": "src/DesignMyNight/" }
    },
    "autoload-dev": {
        "psr-4": { "DesignMyNight\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DesignMyNight\\Laravel\\DesignMyNightApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
